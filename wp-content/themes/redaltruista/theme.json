{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "780px",
			"wideSize": "1170px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "primario", "name": "Verde azulado", "color": "#00827b" },
				{ "slug": "primario-claro", "name": "Turquesa", "color": "#00afa9" },
				{ "slug": "acento", "name": "Cian", "color": "#00bcd4" },
				{ "slug": "menta", "name": "Menta", "color": "#98dad9" },
				{ "slug": "menta-suave", "name": "Menta suave", "color": "#e6f6f5" },
				{ "slug": "amarillo", "name": "Amarillo", "color": "#fec96b" },
				{ "slug": "coral", "name": "Coral", "color": "#ed6967" },
				{ "slug": "oscuro", "name": "Azul noche", "color": "#262e44" },
				{ "slug": "texto", "name": "Texto", "color": "#5c6668" },
				{ "slug": "gris-menu", "name": "Gris menú", "color": "#4a4e57" },
				{ "slug": "gris-claro", "name": "Gris claro", "color": "#f6f6f6" },
				{ "slug": "blanco", "name": "Blanco", "color": "#ffffff" }
			],
			"gradients": [
				{
					"slug": "turquesa",
					"name": "Turquesa",
					"gradient": "linear-gradient(135deg, #00827b 0%, #00afa9 100%)"
				}
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vh", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "2XS", "size": "0.5rem" },
				{ "slug": "30", "name": "XS", "size": "1rem" },
				{ "slug": "40", "name": "S", "size": "1.5rem" },
				{ "slug": "50", "name": "M", "size": "clamp(1.75rem, 3vw, 2.5rem)" },
				{ "slug": "60", "name": "L", "size": "clamp(2.5rem, 5vw, 4rem)" },
				{ "slug": "70", "name": "XL", "size": "clamp(3.5rem, 8vw, 6rem)" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "montserrat",
					"name": "Montserrat",
					"fontFamily": "Montserrat, 'Helvetica Neue', Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/montserrat-latin-wght-normal.woff2" ]
						}
					]
				},
				{
					"slug": "raleway",
					"name": "Raleway",
					"fontFamily": "Raleway, 'Helvetica Neue', Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Raleway",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/raleway-latin-wght-normal.woff2" ]
						}
					]
				},
				{
					"slug": "roboto-condensed",
					"name": "Roboto Condensed",
					"fontFamily": "'Roboto Condensed', 'Arial Narrow', Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Roboto Condensed",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/roboto-condensed-latin-wght-normal.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Pequeño", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Normal", "size": "1rem", "fluid": true },
				{ "slug": "large", "name": "Grande", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "x-large", "name": "Extra grande", "size": "1.625rem", "fluid": { "min": "1.375rem", "max": "1.625rem" } },
				{ "slug": "xx-large", "name": "Titular", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } },
				{ "slug": "huge", "name": "Héroe", "size": "3rem", "fluid": { "min": "2.125rem", "max": "3rem" } }
			]
		},
		"blocks": {
			"core/button": {
				"border": { "radius": true }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--blanco)",
			"text": "var(--wp--preset--color--gris-menu)"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "clamp(1.25rem, 4vw, 2rem)",
				"right": "clamp(1.25rem, 4vw, 2rem)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--raleway)",
			"fontSize": "1.1rem",
			"fontStyle": "normal",
			"fontWeight": "500",
			"lineHeight": "1.55"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primario)" },
				":hover": { "color": { "text": "var(--wp--preset--color--primario-claro)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--primario)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)",
					"fontStyle": "normal",
					"fontWeight": "500",
					"lineHeight": "1.25",
					"letterSpacing": "-0.5px"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)", "letterSpacing": "2px", "lineHeight": "1.15" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "500" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "600" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600", "textTransform": "uppercase" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--acento)",
					"text": "var(--wp--preset--color--blanco)"
				},
				"border": { "radius": "3px" },
				"spacing": { "padding": { "top": "0.8em", "bottom": "0.8em", "left": "1.6em", "right": "1.6em" } },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--roboto-condensed)",
					"fontSize": "1rem",
					"fontWeight": "500",
					"letterSpacing": "2px",
					"textTransform": "uppercase",
					"lineHeight": "1.2"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primario)",
						"text": "var(--wp--preset--color--blanco)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--primario)",
						"text": "var(--wp--preset--color--blanco)"
					}
				}
			},
			"caption": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--roboto-condensed)",
					"fontSize": "0.95rem",
					"letterSpacing": "0px",
					"textTransform": "uppercase"
				},
				"spacing": { "blockGap": "var:preset|spacing|20" },
				"color": { "text": "var(--wp--preset--color--gris-menu)" },
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--gris-menu)" },
						":hover": { "color": { "text": "var(--wp--preset--color--primario)" } }
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": { "color": { "text": "var(--wp--preset--color--primario)" } }
				}
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--menta)" }
			},
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--primario-claro)", "width": "3px", "style": "solid" } },
				"spacing": { "padding": { "left": "1.25rem" } }
			},
			"core/site-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--montserrat)" }
			}
		},
		"variations": {}
	},
	"templateParts": [
		{ "name": "header", "title": "Encabezado", "area": "header" },
		{ "name": "footer", "title": "Pie de página", "area": "footer" }
	],
	"customTemplates": [
		{
			"name": "page-sin-titulo",
			"title": "Página sin título (ancho completo)",
			"postTypes": [ "page" ]
		}
	]
}
